# Copy this file to .env and adjust the values.  (.env is git-ignored.)

# Dashboard title
PROJECT_NAME=Riyadh Smart Parking App

# Task CSV, relative to the project root
DATA_PATH=data/riyadh_smart_parking_tasks.csv

# Status date (YYYY-MM-DD). Leave empty to use today's date.
REPORT_DATE=2026-10-24

# Currency label shown on money values
CURRENCY=SAR

# Overall RAG: Green when CPI and SPI are both >= GREEN, Red when either is < RED
RAG_GREEN_THRESHOLD=0.95
RAG_RED_THRESHOLD=0.85

# Task RAG: cost overrun vs earned value (0.05 = 5%)
TASK_AMBER_OVERRUN=0.05
TASK_RED_OVERRUN=0.15
